{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x86",
      "displayName": "Windows x86",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "inherits": "windows-x86",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "vc6",
      "displayName": "Visual C++ 6.0",
      "generator": "NMake Makefiles",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release_Assertions_Enabled"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS arm64",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-makefile",
      "displayName": "macOS arm64 (Makefiles)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release_Assertions_Enabled",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release_Assertions_Enabled",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug"
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-assertions",
      "configurePreset": "windows-x86",
      "configuration": "Release_Assertions_Enabled"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-assertions",
      "configurePreset": "windows-x64",
      "configuration": "Release_Assertions_Enabled"
    },
    {
      "name": "vc6",
      "configurePreset": "vc6"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos",
      "configuration": "Debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos",
      "configuration": "Release"
    },
    {
      "name": "macos-assertions",
      "configurePreset": "macos",
      "configuration": "Release_Assertions_Enabled"
    },
    {
      "name": "macos-makefile",
      "configurePreset": "macos-makefile"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    }
  ]
}
